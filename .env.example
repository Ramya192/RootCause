# Copy to .env and fill in. Used by:
# - causal_engine/pipeline/explanation.py (Stage 7 LLM narrative; a template is
#   used instead when this is unset)
# - the CrewAI crew's manager LLM (orchestration="crew" requires it, plus ROOTCAUSE_ALLOW_CREW=1)
OPENAI_API_KEY=

# Orchestration "crew" makes many paid LLM calls per run, so the API refuses it unless this is 1.
# Leave it unset on any public deployment.
ROOTCAUSE_ALLOW_CREW=

# How many runs may be queued or running at once before the API answers 429 (default 3).
# ROOTCAUSE_MAX_PENDING=3
